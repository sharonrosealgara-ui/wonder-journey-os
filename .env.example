# ==============================================================================
# WONDER JOURNEY OS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# All values below are non-secret placeholders for local setup, Hostinger staging,
# and production deployments.
#
# NEVER commit real credentials, service-role keys, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT & AUTH CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL
# - Purpose: HTTPS API endpoint URL for your Supabase project.
# - Classification: Public (browser-safe, baked into client bundle).
# - Required: YES (Required for database access and authentication).
# - Staging Source: Supabase Staging Project Settings -> API -> Project URL
# - Production Source: Supabase Production Project Settings -> API -> Project URL
# - Redeploy Required: YES (NEXT_PUBLIC variables are inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY
# - Purpose: Public anonymous JWT key with Row-Level Security (RLS) enforcement.
# - Classification: Public (browser-safe, restricted by RLS policies).
# - Required: YES (Required for user authentication and client queries).
# - Staging Source: Supabase Staging Project Settings -> API -> anon public key
# - Production Source: Supabase Production Project Settings -> API -> anon public key
# - Redeploy Required: YES (Inlined at build time).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# SUPABASE_SERVICE_ROLE_KEY
# - Purpose: Privileged service-role key for backend operations and atomic nonce verification.
# - Classification: Server-only (Strict Secret).
# - Required: YES (Server-only / CI / Local database seeding).
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. SITE URL & HOSTING CONFIGURATION (Required for Production/Staging)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
# - Purpose: Canonical base URL for auth redirects, sitemap generation, and SEO.
# - Classification: Public (browser-safe).
# - Required: YES for custom domains; optional for local dev (defaults to window.location.origin).
# - Staging Value: https://staging.YOUR-DOMAIN.com (or temporary Hostinger preview domain)
# - Production Value: https://YOUR-DOMAIN.com
# - Redeploy Required: YES (Inlined into client builds and sitemaps).
NEXT_PUBLIC_SITE_URL=https://staging.YOUR-DOMAIN.com

# NEXT_PUBLIC_IS_STAGING
# - Purpose: Controls robots.txt noindex policy. When "true", disallows search engine indexing.
# - Classification: Public (browser-safe).
# - Required: Optional (Defaults to false in production, set "true" for staging environments).
# - Staging Value: true
# - Production Value: false
# - Redeploy Required: YES.
NEXT_PUBLIC_IS_STAGING=true

# ------------------------------------------------------------------------------
# 3. LIVE CLASSROOM ACCESS PROTECTION (Optional / Server-Only)
# ------------------------------------------------------------------------------
# WJ_CLASS_CODE / CLASSROOM_CODE
# - Purpose: Shared classroom access passcode for joining LiveKit adventure rooms.
# - Classification: Server-only (Read exclusively in API route handlers).
# - Required: Optional (If unset, room access relies on Supabase user profile role).
# - Staging/Production Source: Administrator generated secure passcode.
# - Redeploy Required: NO (Evaluated at runtime per request).
WJ_CLASS_CODE=

# ------------------------------------------------------------------------------
# 4. LIVEKIT REAL-TIME VIDEO/AUDIO SERVICE (Optional for Live Video)
# ------------------------------------------------------------------------------
# LIVEKIT_URL
# - Purpose: WebSocket endpoint (wss://) for LiveKit real-time communication server.
# - Classification: Server-only (Returned securely in token payload).
# - Required: Optional (Required only if live classroom video/audio is active).
# - Staging/Production Source: LiveKit Cloud Dashboard -> Project Settings -> WebSocket URL.
# - Redeploy Required: NO (Runtime API evaluation).
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# LIVEKIT_API_KEY
# - Purpose: LiveKit API key for signing room access JWT tokens.
# - Classification: Server-only (Strict secret, never exposed to client).
# - Required: Optional (Required if LiveKit is active).
# - Staging/Production Source: LiveKit Cloud Dashboard -> Keys.
# - Redeploy Required: NO.
LIVEKIT_API_KEY=

# LIVEKIT_API_SECRET
# - Purpose: LiveKit API secret for signing JWT tokens.
# - Classification: Server-only (Strict secret, never exposed to client).
# - Required: Optional (Required if LiveKit is active).
# - Staging/Production Source: LiveKit Cloud Dashboard -> Keys.
# - Redeploy Required: NO.
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# 5. GAME EVALUATION SECRET (Server-Only Cryptographic Key)
# ------------------------------------------------------------------------------
# GAME_EVALUATION_SECRET
# - Purpose: AES-256-GCM secret key for sealing/unsealing tamper-proof game solution tokens.
# - Classification: Server-only (Strict secret, never exposed to client).
# - Required: YES (Minimum 16 characters).
GAME_EVALUATION_SECRET=

# ------------------------------------------------------------------------------
# 6. END-TO-END AUTOMATION CREDENTIALS (Local / CI Only)
# ------------------------------------------------------------------------------
# E2E_TEACHER_PASSWORD
# - Purpose: Ephemeral password for the seeded teacher user during Playwright E2E tests.
# - Classification: Sensitive Test Credential (Never hardcode in source).
E2E_TEACHER_PASSWORD=

# E2E_FAMILY_PASSWORD
# - Purpose: Ephemeral password for the seeded family user during Playwright E2E tests.
# - Classification: Sensitive Test Credential (Never hardcode in source).
E2E_FAMILY_PASSWORD=

# ------------------------------------------------------------------------------
# 7. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# NODE_ENV
# - Purpose: Standard Node.js environment flag ("development", "production", "test").
# - Classification: Server-only / Build tool standard.
# - Required: Automatically managed by Next.js ("production" during next start).
NODE_ENV=production
